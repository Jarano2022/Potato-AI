# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# HERMES_API_KEY: Token o API Key de tu instancia de Hermes Agent (ej. daemon :8642, OpenRouter, etc.)
# Configúrala aquí para mantenerla segura y privada fuera del navegador y de Git.
HERMES_API_KEY=""

# HERMES_ENDPOINT: Endpoint HTTP de tu Hermes Agent
HERMES_ENDPOINT="http://100.94.150.43:8642/v1/chat/completions"
